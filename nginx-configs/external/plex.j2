# main server
server {
	listen {{ nginx_backend_port }};
	server_name moopies.thejfk.ca movies.thejfk.ca plex.thejfk.ca moopies.ca;

	location / {
		proxy_set_header Host $http_host;
		proxy_pass http://plex.jfkhome:32400;
	}
	include snippets/health-check.conf;
}

# plex statistics
server {
	listen {{ nginx_backend_port }};
	server_name plexstats.thejfk.ca;

	location / {
		proxy_set_header Host $http_host;
		proxy_pass http://plex.jfkhome:8181;
	}
}
